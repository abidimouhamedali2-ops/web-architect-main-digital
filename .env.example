# Nexus Website - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================
# EMAIL INTEGRATION (EmailJS)
# ============================================
# Get your keys from: https://www.emailjs.com/
# Free tier: 200 emails/month
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# ============================================
# GOOGLE ANALYTICS
# ============================================
# Get your ID from: https://analytics.google.com/
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# GITHUB API (Optional)
# ============================================
# For dynamically fetching project data
# Your GitHub username
VITE_GITHUB_USERNAME=your_github_username

# Personal Access Token (optional, for higher rate limits)
# Create at: https://github.com/settings/tokens
# VITE_GITHUB_TOKEN=ghp_your_token_here

# ============================================
# CONTENTFUL CMS (Optional)
# ============================================
# For dynamic blog content management
# Get from: https://www.contentful.com/
# VITE_CONTENTFUL_SPACE_ID=your_space_id
# VITE_CONTENTFUL_ACCESS_TOKEN=your_access_token
# VITE_CONTENTFUL_ENVIRONMENT=master

# ============================================
# NOTES
# ============================================
# 1. Never commit .env.local to version control
# 2. All variables must start with VITE_ to be accessible in the browser
# 3. Restart dev server after changing .env files
# 4. For production, set these in your hosting platform (Vercel, Netlify, etc.)
